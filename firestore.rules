rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──────────────────────────────────────────────────
    // Each user can only read/write their own document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Scans subcollection
      match /scans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Crops subcollection (Farm Diary)
      match /crops/{cropId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── On-device scans (top-level collection) ────────────────────────────
    match /onDeviceScans/{scanId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // ── Advanced scans (top-level collection) ─────────────────────────────
    match /advancedScans/{scanId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // ── Bug reports ───────────────────────────────────────────────────────
    // Anyone authenticated can create a bug report (read restricted to admin)
    match /bug_reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // admin only via Firebase console
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
