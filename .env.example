# Copy this file to `.env` and fill in your own keys. Never commit `.env`.
#
# NOTE: anything in `.env` is bundled into the app and can be extracted from
# the APK. For a production release, move these calls behind a backend
# (e.g. Firebase Cloud Functions) and keep the keys server-side.

# Groq (AI advice, chatbot, disease explanations)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional vision model override
GROQ_VISION_MODEL=

# Plant.id (Advanced scan)
PLANTID_API_KEY=

# Pl@ntNet (optional fallback identification)
PLANTNET_API_KEY=

# WeatherAPI.com (home screen weather)
WEATHER_API_KEY=

# RECOMMENDED for release builds: URL of the Cloud Functions proxy
# (see functions/README.md). When set, the three keys above are NOT used and
# should be deleted from this file so they are not packed into the APK.
API_PROXY_URL=
